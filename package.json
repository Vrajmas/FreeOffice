{
  "name": "personal-office",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run dev:documents",
    "dev:documents": "electron_config_cache=.cache/electron concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:spreadsheets": "VITE_APP_KIND=sheet electron_config_cache=.cache/electron concurrently \"vite\" \"wait-on http://localhost:5173 && OFFICE_KIND=sheet electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "build:apps": "zsh scripts/build-apps.sh",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:android": "node scripts/build-android.mjs",
    "release:check": "node scripts/check-release.mjs",
    "naming:check": "node scripts/validate-naming.mjs",
    "naming:test": "node --test scripts/validate-naming.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "docx": "^9.10.0",
    "dompurify": "^3.4.16",
    "hyperformula": "^3.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "linkedom": "^0.18.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
